<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><meta name="theme-color" content="#6d28d9"><title>دفتر درجاتي</title>
<style>
:root{--p:#6d28d9;--bg:#f7f5fc;--ink:#241b35;--line:#e8e1f2;--muted:#766d85}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif}header{background:linear-gradient(135deg,#6d28d9,#8b5cf6);color:white;padding:22px 16px 25px;border-radius:0 0 24px 24px}header h1{margin:0 0 5px;font-size:25px}header p{margin:0;opacity:.92;font-size:14px}.wrap{max-width:1100px;margin:auto;padding:14px}.panel{background:white;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:13px;box-shadow:0 4px 15px #33204b08}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field label{display:block;font-size:12px;color:#6b617a;margin-bottom:5px}.field input,.field select,button{font:inherit;border-radius:10px;border:1px solid #d9d0e8;padding:10px;background:#fff;color:var(--ink);width:100%;min-height:42px}.field input:focus,.field select:focus{outline:2px solid #c4b5fd;border-color:var(--p)}button{cursor:pointer;background:var(--p);color:white;border:0;font-weight:650}button.secondary{background:#f0eafe;color:#5421ad}button.danger{background:#fff0f0;color:#b42318;border:1px solid #ffd3d3}.actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:0 0 10px}.section-title h2{font-size:17px;margin:0}.muted{font-size:12px;color:var(--muted)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{border-collapse:separate;border-spacing:0;width:100%;min-width:690px;background:white}th,td{padding:9px 8px;text-align:right;border-bottom:1px solid var(--line);font-size:13px;white-space:nowrap}th{background:#f4efff;color:#4c277e;position:sticky;top:0}tr:last-child td{border-bottom:0}td input{width:82px;padding:8px;border:1px solid #ded6eb;border-radius:8px;font:inherit;text-align:center}td.name{font-weight:600;max-width:210px;white-space:normal}td .smallbtn{width:auto;min-height:32px;padding:5px 8px;font-size:12px}.summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.stat{background:#f7f3ff;border-radius:12px;padding:11px}.stat span{display:block;font-size:11px;color:#74658a}.stat strong{display:block;font-size:20px;margin-top:3px}.note{font-size:12px;line-height:1.7;color:#6d647b;margin:10px 0 0}.empty{text-align:center;color:#8b819b;padding:25px}.toast{font-size:13px;color:#166534;margin-top:8px;min-height:18px}.pill{background:#f0eafe;color:#5421ad;border-radius:99px;padding:5px 9px;font-size:11px}.setting-help{font-size:12px;color:#6d647b;line-height:1.6;margin:8px 0 0}@media(min-width:700px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}.actions{grid-template-columns:repeat(4,minmax(0,1fr))}.wrap{padding:20px}.panel{padding:18px}}

.welcome{max-width:760px;margin:24px auto;padding:18px}.welcome-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:0 10px 35px #33204b10}.brand-mark{width:76px;height:76px;border-radius:22px;background:linear-gradient(145deg,#6d28d9,#a78bfa);display:grid;place-items:center;margin:0 auto 12px;box-shadow:0 8px 18px #6d28d933}.brand-mark svg{width:48px;height:48px}.welcome h1{text-align:center;color:#5421ad;margin:0 0 5px;font-size:25px}.welcome .intro{text-align:center;color:var(--muted);margin:0 0 20px;font-size:14px}.welcome .grid{grid-template-columns:1fr}.welcome .field label{font-size:13px}.welcome .continue{margin-top:16px;min-height:48px;font-size:16px}.app-hidden{display:none!important}.print-meta{display:none}
.preview-overlay{position:fixed;inset:0;background:#f4f0fa;z-index:9999;overflow:auto;padding:14px;display:none}
.preview-overlay.open{display:block}
.preview-toolbar{position:sticky;top:0;z-index:2;background:#fff;border:1px solid #ddd6fe;border-radius:14px;padding:10px;display:flex;gap:8px;flex-wrap:wrap;margin:0 auto 12px;max-width:1100px}
.preview-sheet{background:#fff;color:#111;max-width:1100px;min-height:400px;margin:0 auto;padding:22px;box-shadow:0 4px 22px #24133b18;border:1px solid #e5e7eb;overflow-x:auto}
.preview-sheet h2{text-align:center;color:#5421ad;margin:0 0 12px}
.preview-sheet .preview-meta{display:flex;gap:8px 18px;flex-wrap:wrap;line-height:1.9;margin-bottom:14px;font-size:13px}
.preview-sheet table{width:100%;border-collapse:collapse;min-width:700px}
.preview-sheet th,.preview-sheet td{border:1px solid #aaa;padding:7px;text-align:center;font-size:12px;color:#111}
.preview-sheet th{background:#eee}
.preview-sheet td input{display:none}
@media(min-width:600px){.welcome .grid{grid-template-columns:repeat(2,minmax(0,1fr))}.welcome .field.wide{grid-column:span 2}}
@media print{
@page{size:A4 landscape;margin:10mm}
body{background:#fff;color:#000;font-size:10pt}
header{background:#fff!important;color:#000!important;border-radius:0;padding:0 0 8px;border-bottom:2px solid #6d28d9}
header h1{font-size:18pt}
header p{color:#222!important}
main.wrap{max-width:none;padding:8px 0}
main .panel{display:none!important}
main .panel:has(#tbody){display:block!important;border:0;box-shadow:none;padding:0;margin:0}
main .panel:has(#tbody) .section-title{display:none}
main .panel:has(#tbody) .summary{display:none}
main .panel:has(#tbody) .table-wrap{overflow:visible;border:0;margin:0!important}
table{min-width:0!important;width:100%;border-collapse:collapse;table-layout:auto}
th,td{position:static!important;white-space:normal;font-size:8.5pt;padding:5px;border:1px solid #aaa;color:#000}
th{background:#eee!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
td input{display:none}
td.name{max-width:none}
.print-meta{display:block;margin:0 0 10px;font-size:10pt;line-height:1.8}
.no-print{display:none!important}
}
</style></head>
<body>
<section class="welcome" id="welcomeScreen">
  <div class="welcome-card">
    <div class="brand-mark" aria-label="شعار دفتر درجاتي">
      <svg viewBox="0 0 64 64" role="img" aria-label="كتاب وقلم"><path d="M10 14c9-4 17-2 22 3v34c-6-5-14-7-22-3z" fill="#fff" opacity=".98"/><path d="M54 14c-9-4-17-2-22 3v34c6-5 14-7 22-3z" fill="#ede9fe"/><path d="M32 17v34" stroke="#6d28d9" stroke-width="2.5"/><path d="M42 8l6 3-17 31-6 3 1-7z" fill="#fef3c7" stroke="#fff" stroke-width="1.5"/><path d="M25 45l6-3-5-3z" fill="#fff"/></svg>
    </div>
    <h1>دفتر درجاتي</h1>
    <p class="intro">رتّب معلومات مدرستك حتى نفتح دفتر الدرجات</p>
    <div class="grid">
      <div class="field wide"><label for="welcomeSchool">اسم المدرسة</label><input id="welcomeSchool" placeholder="اكتب اسم المدرسة" autocomplete="organization"></div>
      <div class="field"><label for="welcomeYear">السنة الدراسية</label><input id="welcomeYear" value="2026–2027"></div>
      <div class="field"><label for="welcomeTeacher">اسم الأستاذ</label><input id="welcomeTeacher" placeholder="اكتب اسم الأستاذ" autocomplete="name"></div>
      <div class="field"><label for="welcomeSubject">المادة</label><input id="welcomeSubject" value="الأحياء"></div>
      <div class="field"><label for="welcomeGrade">الصف</label><select id="welcomeGrade"><option>الأول الابتدائي</option><option>الثاني الابتدائي</option><option>الثالث الابتدائي</option><option>الرابع الابتدائي</option><option>الخامس الابتدائي</option><option selected>السادس الابتدائي</option><option>الأول المتوسط</option><option>الثاني المتوسط</option><option>الثالث المتوسط</option><option>الرابع العلمي</option><option>الخامس العلمي</option><option>السادس العلمي</option><option>أخرى</option></select></div>
    </div>
    <button id="continueBtn" class="continue">متابعة إلى دفتر الدرجات</button>
  </div>
</section>
<header id="appHeader" class="app-hidden"><div class="wrap" style="padding:0"><div style="display:flex;align-items:center;gap:10px"><div class="brand-mark" style="width:48px;height:48px;border-radius:14px;margin:0;box-shadow:none"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M10 14c9-4 17-2 22 3v34c-6-5-14-7-22-3z" fill="#fff"/><path d="M54 14c-9-4-17-2-22 3v34c6-5 14-7 22-3z" fill="#ede9fe"/><path d="M32 17v34" stroke="#6d28d9" stroke-width="2.5"/></svg></div><div><h1>دفتر درجاتي</h1><p id="schoolDisplay">اسم المدرسة يظهر هنا</p><p id="headerMeta">دفتر درجات الطلاب — 2026–2027</p></div></div></div></header>
<main class="wrap app-hidden" id="appMain">
<section class="panel"><div class="section-title"><h2>إعداد الصف</h2><span class="muted">اختَر الصف والشعبة والشهر</span></div><div class="grid">
<div class="field" style="grid-column:span 2"><label for="schoolName">اسم المدرسة</label><input id="schoolName" placeholder="اكتب اسم المدرسة" autocomplete="organization"></div>
<div class="field"><label for="grade">الصف</label><select id="grade"><option>الأول الابتدائي</option><option>الثاني الابتدائي</option><option>الثالث الابتدائي</option><option>الرابع الابتدائي</option><option>الخامس الابتدائي</option><option selected>السادس الابتدائي</option></select></div>
<div class="field"><label for="classroom">الشعبة</label><select id="classroom"><option>أ</option><option>ب</option><option>ج</option><option>د</option><option>أخرى</option></select></div>
<div class="field"><label for="subject">المادة</label><input id="subject" value="الأحياء"></div><div class="field"><label for="year">السنة الدراسية</label><input id="year" value="2026–2027"></div><div class="field"><label for="teacherName">اسم الأستاذ</label><input id="teacherName" placeholder="اكتب اسم الأستاذ"></div>
<div class="field"><label for="month">الشهر</label><select id="month"><option selected>الشهر الأول</option><option>الشهر الثاني</option></select></div>
</div><p class="note">قائمة الطلاب ترتبط بالصف والشعبة والمادة والسنة، أما الدرجات فتنحفظ لكل شهر بصورة منفصلة.</p></section>
<section class="panel"><div class="section-title"><h2>إعدادات الدرجات</h2><span class="pill">قابلة للتعديل</span></div><div class="grid">
<div class="field"><label for="maxDaily">الدرجة القصوى لليومي</label><input id="maxDaily" type="number" min="0.5" step="any" value="20"></div>
<div class="field"><label for="maxOral">الدرجة القصوى للشفهي</label><input id="maxOral" type="number" min="0.5" step="any" value="10"></div>
<div class="field"><label for="maxBehavior">الدرجة القصوى للسلوك</label><input id="maxBehavior" type="number" min="0.5" step="any" value="10"></div>
<div class="field"><label for="maxExam">الدرجة القصوى لامتحان الشهر</label><input id="maxExam" type="number" min="0.5" step="any" value="100"></div>
<div class="field" style="align-self:end"><button id="saveSettings">حفظ إعدادات الدرجات</button></div></div><p class="setting-help">حدود اليومي والشفهي والسلوك قيم افتراضية قابلة للتغيير. مجموع الشهر = اليومي + الشفهي + السلوك + امتحان الشهر. السعي = متوسط مجموع الشهر الأول والثاني، ويُقرّب لأقرب عدد صحيح.</p></section>
<section class="panel"><div class="section-title"><h2>إضافة طالب</h2><span class="muted" id="count">0 طالب</span></div><div class="grid"><div class="field" style="grid-column:span 2"><label for="studentName">اسم الطالب الكامل</label><input id="studentName" placeholder="اكتب اسم الطالب هنا" autocomplete="off"></div><div class="field" style="align-self:end"><button id="addStudent">+ إضافة الطالب</button></div></div><div class="toast" id="toast" aria-live="polite"></div></section>
<section class="panel"><div class="section-title"><h2>درجات الطلاب</h2><span class="muted">الدرجات تحفظ تلقائياً على هذا الجهاز</span></div><div class="actions no-print" style="margin:0 0 12px"><button id="printGrades">🖨️ طباعة كشف الدرجات</button></div><div class="print-meta" id="printMeta"></div><div class="summary"><div class="stat"><span>عدد الطلاب</span><strong id="statCount">0</strong></div><div class="stat"><span>درجات يومية مدخلة</span><strong id="statDaily">0</strong></div><div class="stat"><span>درجات شهرية مدخلة</span><strong id="statExam">0</strong></div></div><div class="table-wrap" style="margin-top:12px"><table><thead><tr><th>#</th><th>اسم الطالب</th><th id="dailyHead">اليومي / 20</th><th id="oralHead">الشفهي / 10</th><th id="behaviorHead">السلوك / 10</th><th id="examHead">امتحان الشهر / 100</th><th>مجموع الشهر</th><th>السعي (متوسط شهرين)</th><th>إجراء</th></tr></thead><tbody id="tbody"><tr><td colspan="9" class="empty">أضف أسماء الطلاب حتى يظهر الجدول هنا.</td></tr></tbody></table></div><p class="note">إذا أدخلت درجة أكبر من الحد الأقصى المحدد، يرفضها التطبيق ويطلب تصحيحها. مجموع الشهر يجمع اليومي والشفهي والسلوك وامتحان الشهر. السعي هو متوسط مجموع الشهر الأول والثاني مع التقريب لأقرب عدد صحيح.</p></section>
<section class="panel"><div class="section-title"><h2>النسخ الاحتياطي</h2><span class="muted">احتفظ بنسخة خارج الجهاز</span></div><div class="actions"><button id="exportBackup">تنزيل نسخة احتياطية</button><button class="secondary" id="importBtn">استعادة نسخة</button><button class="secondary" id="exportCsv">تصدير الجدول CSV</button><button class="danger" id="clearAll">مسح بيانات هذا الدفتر</button></div><input type="file" id="importFile" accept="application/json,.json" hidden><p class="note">هذه النسخة تحفظ محلياً داخل المتصفح، وتتيح تصدير نسخة احتياطية. المزامنة السحابية بين الأجهزة تحتاج إعداد خدمة وربط حساب في مرحلة لاحقة.</p></section>
</main>
<section id="previewOverlay" class="preview-overlay" aria-label="معاينة كشف الدرجات">
  <div class="preview-toolbar no-print">
    <button id="previewPrint">🖨️ طباعة / حفظ PDF</button>
    <button id="previewClose" class="secondary">رجوع للدفتر</button>
    <span style="align-self:center;color:#6b7280;font-size:13px">راجع أسماء الطلاب والدرجات قبل الطباعة</span>
  </div>
  <div class="preview-sheet" id="previewSheet">
    <h2>كشف درجات الطلاب</h2>
    <div class="preview-meta" id="previewMeta"></div>
    <div id="previewTable"></div>
  </div>
</section>
<script>
(()=>{'use strict';const $=id=>document.getElementById(id);const KEY='daftarDarajatiPrototypeV2';let db={rosters:{},grades:{},settings:{daily:20,oral:10,behavior:10,exam:100},schoolName:'',teacherName:'',profile:{year:'2026–2027',grade:'السادس الابتدائي',classroom:'أ',subject:'الأحياء'}};let toastTimer;try{const raw=localStorage.getItem(KEY);if(raw){const parsed=JSON.parse(raw);if(parsed&&parsed.rosters&&parsed.grades){db={...db,...parsed,settings:{...db.settings,...(parsed.settings||{})},schoolName:parsed.schoolName||'',teacherName:parsed.teacherName||'',profile:{year:'2026–2027',grade:'السادس الابتدائي',classroom:'أ',subject:'الأحياء',...(parsed.profile||{})}};}}}catch(e){}
$('schoolName').value=db.schoolName||'';$('teacherName').value=db.teacherName||'';$('year').value=db.profile.year||'2026–2027';$('grade').value=db.profile.grade||'السادس الابتدائي';$('classroom').value=db.profile.classroom||'أ';$('subject').value=db.profile.subject||'الأحياء';$('schoolDisplay').textContent=db.schoolName||'أضف اسم المدرسة من إعداد الصف';$('welcomeSchool').value=db.schoolName||'';$('welcomeTeacher').value=db.teacherName||'';$('welcomeYear').value=$('year').value;$('welcomeSubject').value=$('subject').value;$('welcomeGrade').value=$('grade').value;
function saveProfile(){db.schoolName=$('schoolName').value.trim();db.teacherName=$('teacherName').value.trim();db.profile={year:$('year').value,grade:$('grade').value,classroom:$('classroom').value,subject:$('subject').value};$('schoolDisplay').textContent=db.schoolName||'أضف اسم المدرسة من إعداد الصف';$('headerMeta').textContent='دفتر درجات الطلاب — '+$('year').value;save();}
$('schoolName').addEventListener('input',saveProfile);$('teacherName').addEventListener('change',saveProfile);const rosterKey=()=>[$('year').value,$('grade').value,$('classroom').value,$('subject').value].join('|');const ctx=()=>rosterKey()+'|'+$('month').value;const keyFor=id=>ctx()+'|'+id;const roster=()=>{const k=rosterKey();if(!Array.isArray(db.rosters[k]))db.rosters[k]=[];return db.rosters[k]};const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(db));}catch(e){say('تعذّر الحفظ في المتصفح. نزّل نسخة احتياطية.');}};function say(s){$('toast').textContent=s;clearTimeout(toastTimer);toastTimer=setTimeout(()=>{$('toast').textContent='';},3500)}const maxFor=f=>Number(db.settings[f]);
function applySettingsToInputs(){ $('maxDaily').value=db.settings.daily; $('maxOral').value=db.settings.oral; $('maxExam').value=db.settings.exam; $('maxBehavior').value=db.settings.behavior; updateHeads(); }
function updateHeads(){ $('dailyHead').textContent='اليومي / '+maxFor('daily');$('oralHead').textContent='الشفهي / '+maxFor('oral');$('behaviorHead').textContent='السلوك / '+maxFor('behavior');$('examHead').textContent='امتحان الشهر / '+maxFor('exam'); }
function monthTotal(g){const fields=['daily','oral','behavior','exam'];if(!fields.some(f=>g&&g[f]!==''&&g[f]!=null))return null;return fields.reduce((sum,f)=>sum+(g&&g[f]!==''&&g[f]!=null?Number(g[f])||0:0),0)}function monthGrade(studentId,monthName){const g=db.grades[rosterKey()+'|'+monthName+'|'+studentId]||{};return monthTotal(g)}function effortFor(studentId){const a=monthGrade(studentId,'الشهر الأول'),b=monthGrade(studentId,'الشهر الثاني');return a===null||b===null?'—':String(Math.round((a+b)/2))}function updateComputedCells(tr,studentId){const current=db.grades[keyFor(studentId)]||{};const total=monthTotal(current);const t=tr.querySelector('[data-calc="total"]');const e=tr.querySelector('[data-calc="effort"]');if(t)t.textContent=total===null?'—':String(total);if(e)e.textContent=effortFor(studentId)}
function render(){const tb=$('tbody');tb.innerHTML='';const list=roster();if(!list.length){tb.innerHTML='<tr><td colspan="9" class="empty">أضف أسماء الطلاب حتى يظهر الجدول هنا.</td></tr>';}$('count').textContent=list.length+' طالب';list.forEach((s,i)=>{const k=keyFor(s.id);const g=db.grades[k]||{daily:'',oral:'',behavior:'',exam:''};const tr=document.createElement('tr');const n=document.createElement('td');n.textContent=i+1;tr.appendChild(n);const name=document.createElement('td');name.className='name';name.textContent=s.name;tr.appendChild(name);for(const field of ['daily','oral','behavior','exam']){const td=document.createElement('td');const inp=document.createElement('input');inp.type='number';inp.min='0';inp.max=String(maxFor(field));inp.step='any';inp.inputMode='decimal';inp.placeholder='—';inp.setAttribute('aria-label',s.name+' '+({daily:'اليومي',oral:'الشفهي',behavior:'السلوك',exam:'امتحان الشهر'}[field]));inp.value=g[field]??'';inp.addEventListener('change',()=>{const val=inp.value.trim();if(val!==''&&(!Number.isFinite(Number(val))||Number(val)<0||Number(val)>maxFor(field))){say('الدرجة لازم تكون بين 0 و '+maxFor(field)+'.');inp.value=g[field]??'';return;}const now=db.grades[k]||{daily:'',oral:'',behavior:'',exam:''};now[field]=val;db.grades[k]=now;save();updateComputedCells(tr,s.id);stats();say('تم حفظ الدرجة على هذا الجهاز.');});td.appendChild(inp);tr.appendChild(td);}for(const type of ['total','effort']){const td=document.createElement('td');td.dataset.calc=type;td.textContent='—';tr.appendChild(td);}updateComputedCells(tr,s.id);const td=document.createElement('td');const del=document.createElement('button');del.className='smallbtn danger';del.textContent='حذف';del.addEventListener('click',()=>{if(confirm('حذف الطالب '+s.name+' من قائمة هذه الشعبة؟')){db.rosters[rosterKey()]=roster().filter(x=>x.id!==s.id);Object.keys(db.grades).forEach(x=>{if(x.startsWith(rosterKey()+'|')&&x.endsWith('|'+s.id))delete db.grades[x]});save();render();say('تم حذف الطالب ودرجاته من هذا الدفتر.');}});td.appendChild(del);tr.appendChild(td);tb.appendChild(tr);});stats();}
function stats(){const list=roster();let daily=0,exam=0;list.forEach(s=>{const g=db.grades[keyFor(s.id)]||{};if(g.daily!==''&&g.daily!=null)daily++;if(g.exam!==''&&g.exam!=null)exam++;});$('statCount').textContent=list.length;$('statDaily').textContent=daily;$('statExam').textContent=exam;}
$('saveSettings').addEventListener('click',()=>{const vals={daily:$('maxDaily').value.trim(),oral:$('maxOral').value.trim(),behavior:$('maxBehavior').value.trim(),exam:$('maxExam').value.trim()};for(const [k,v] of Object.entries(vals)){if(v===''||!Number.isFinite(Number(v))||Number(v)<=0){say('اكتب درجة قصوى صحيحة وأكبر من صفر لكل نوع.');return;}}const next={daily:Number(vals.daily),oral:Number(vals.oral),behavior:Number(vals.behavior),exam:Number(vals.exam)};for(const s of roster()){const g=db.grades[keyFor(s.id)]||{};for(const f of ['daily','oral','behavior','exam'])if(g[f]!==''&&g[f]!=null&&Number(g[f])>next[f]){say('ما نكدر نقلل الحد الأقصى لأن عندك درجة '+({daily:'يومية',oral:'شفهية',behavior:'سلوك',exam:'شهرية'}[f])+' أعلى من الحد الجديد. عدّل الدرجة أولاً.');return;}}db.settings=next;save();updateHeads();render();say('تم حفظ حدود الدرجات الجديدة.');});
$('addStudent').addEventListener('click',()=>{const name=$('studentName').value.trim();if(!name){say('اكتب اسم الطالب أولاً.');$('studentName').focus();return;}if(roster().some(s=>s.name===name)){if(!confirm('هذا الاسم موجود بالقائمة. تريد إضافته مرة ثانية؟'))return;}roster().push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),name});$('studentName').value='';save();render();say('انضاف الطالب وانحفظ.');});$('studentName').addEventListener('keydown',e=>{if(e.key==='Enter')$('addStudent').click();});['year','grade','classroom','subject'].forEach(id=>$(id).addEventListener('change',()=>{saveProfile();render();}));$('month').addEventListener('change',render);
$('continueBtn').addEventListener('click',()=>{if(!$('welcomeSchool').value.trim()){alert('حجي، اكتب اسم المدرسة أولاً حتى نكمل.');$('welcomeSchool').focus();return;} $('schoolName').value=$('welcomeSchool').value.trim();$('teacherName').value=$('welcomeTeacher').value.trim();$('year').value=$('welcomeYear').value.trim()||'2026–2027';$('subject').value=$('welcomeSubject').value.trim()||'الأحياء';$('grade').value=$('welcomeGrade').value;saveProfile();$('welcomeScreen').classList.add('app-hidden');$('appHeader').classList.remove('app-hidden');$('appMain').classList.remove('app-hidden');render();});
function escapeHtml(v){return String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
$('printGrades').addEventListener('click',()=>{const meta=[['المدرسة',$('schoolName').value],['الأستاذ',$('teacherName').value],['السنة الدراسية',$('year').value],['الصف',$('grade').value],['الشعبة',$('classroom').value],['المادة',$('subject').value],['الشهر',$('month').value]];$('previewMeta').innerHTML=meta.map(([k,v])=>'<span><strong>'+k+':</strong> '+escapeHtml(v||'—')+'</span>').join('　 |　 ');const table=$('tbody').closest('table').cloneNode(true);table.querySelectorAll('input,button,select').forEach(el=>{const td=el.closest('td');if(td){td.textContent=el.value||'—';}else el.remove();});table.querySelectorAll('th:last-child,td:last-child').forEach(el=>el.remove());$('previewTable').replaceChildren(table);$('previewOverlay').classList.add('open');});
$('previewClose').addEventListener('click',()=>$('previewOverlay').classList.remove('open'));
$('previewPrint').addEventListener('click',()=>window.print());
function download(name,content,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
$('exportBackup').addEventListener('click',()=>{download('daftar-darajati-backup.json',JSON.stringify({app:'دفتر درجاتي',version:3,exportedAt:new Date().toISOString(),data:db},null,2),'application/json;charset=utf-8');say('جهزنا ملف النسخة الاحتياطية.');});$('importBtn').addEventListener('click',()=>$('importFile').click());$('importFile').addEventListener('change',async e=>{const f=e.target.files&&e.target.files[0];if(!f)return;try{const obj=JSON.parse(await f.text());const incoming=obj.data||obj;if(!incoming.rosters||!incoming.grades)throw new Error('bad');if(!confirm('استعادة النسخة تستبدل البيانات الحالية. هل تريد المتابعة؟'))return;db={rosters:incoming.rosters,grades:incoming.grades,settings:{daily:20,oral:10,behavior:10,exam:100,...(incoming.settings||{})},schoolName:incoming.schoolName||'',teacherName:incoming.teacherName||'',profile:{year:'2026–2027',grade:'السادس الابتدائي',classroom:'أ',subject:'الأحياء',...(incoming.profile||{})}};$('schoolName').value=db.schoolName;$('teacherName').value=db.teacherName;$('year').value=db.profile.year;$('grade').value=db.profile.grade;$('classroom').value=db.profile.classroom;$('subject').value=db.profile.subject;$('welcomeSchool').value=db.schoolName;$('welcomeTeacher').value=db.teacherName;$('welcomeYear').value=db.profile.year;$('welcomeSubject').value=db.profile.subject;$('welcomeGrade').value=db.profile.grade;$('schoolDisplay').textContent=db.schoolName||'أضف اسم المدرسة من إعداد الصف';save();applySettingsToInputs();$('headerMeta').textContent='دفتر درجات الطلاب — '+$('year').value;render();say('تمت استعادة النسخة الاحتياطية.');}catch(err){say('الملف غير صالح أو ليس نسخة من دفتر درجاتي.');}finally{e.target.value='';}});
$('exportCsv').addEventListener('click',()=>{const rows=[['اسم المدرسة','اسم الأستاذ','السنة','الصف','الشعبة','المادة','الشهر','اسم الطالب','اليومي','الشفهي','السلوك','امتحان الشهر','مجموع الشهر','السعي']];roster().forEach(s=>{const g=db.grades[keyFor(s.id)]||{};rows.push([db.schoolName||'', db.teacherName||'', $('year').value,$('grade').value,$('classroom').value,$('subject').value,$('month').value,s.name,g.daily??'',g.oral??'',g.behavior??'',g.exam??'',monthTotal(g),effortFor(s.id)]);});const csv='\ufeff'+rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');download('daftar-darajati.csv',csv,'text/csv;charset=utf-8');say('تم تصدير الجدول.');});$('clearAll').addEventListener('click',()=>{if(confirm('متأكد؟ سيتم حذف كل الطلاب والدرجات المحفوظة في هذا النموذج من هذا المتصفح.')){db={rosters:{},grades:{},settings:{...db.settings},schoolName:$('schoolName').value.trim(),teacherName:$('teacherName').value.trim(),profile:{year:$('year').value,grade:$('grade').value,classroom:$('classroom').value,subject:$('subject').value}};save();render();say('تم مسح بيانات الطلاب والدرجات.');}});applySettingsToInputs();$('headerMeta').textContent='دفتر درجات الطلاب — '+$('year').value;render();
})();
</script></body></html>
